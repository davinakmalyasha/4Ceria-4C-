{
    "private": true,
    "type": "module",
    "engines": {
        "//": "Floor, not a pin: CI and .nvmrc both target Node 20, and the build also passes on 26. Declared so a contributor on something older gets a warning instead of a Vite error.",
        "node": ">=20"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js --ext .ts,.tsx",
        "typecheck": "tsc --noEmit",
        "typecheck:check": "node scripts/typecheck-baseline.mjs",
        "typecheck:parity": "node scripts/ci/assert-ts-parity.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/node": "^26.6.5",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react": "^4.7.0",
        "@vitest/coverage-v8": "^2.1.8",
        "autoprefixer": "^10.4.2",
        "axios": "^1.13.6",
        "concurrently": "^9.0.1",
        "eslint": "^10.9.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "js-yaml": "^4.1.0",
        "jsdom": "^25.0.1",
        "laravel-vite-plugin": "^1.2.0",
        "playwright": "^1.64.1",
        "postcss": "^8.4.31",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-router-dom": "^7.13.1",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.67.0",
        "vite": "^6.0.0",
        "vite-plugin-pwa": "^1.2.0",
        "vitest": "^2.1.8",
        "workbox-expiration": "7.4.1",
        "workbox-precaching": "7.4.1",
        "workbox-routing": "7.4.1",
        "workbox-strategies": "7.4.1"
    },
    "dependencies": {
        "date-fns": "^4.1.0",
        "framer-motion": "^12.38.0",
        "html2canvas": "^1.4.1",
        "jspdf": "^4.2.1",
        "lucide-react": "^0.577.0",
        "maplibre-gl": "^4.7.1",
        "react-map-gl": "^8.1.0"
    }
}
