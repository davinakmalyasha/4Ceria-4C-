# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
/node_modules
/web/node_modules
/web/.next
/web/.next-*
/web/tsconfig.tsbuildinfo
dist/
.vite/

# Go build output (go build ./cmd/... writes binaries here on Windows).
/*.exe

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
auth.json

# ---------------------------------------------------------------------------
# OS and editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
.idea
.vscode
.zed
.fleet

# Office lock files and editor temp files
~$*
*.tmp

# ---------------------------------------------------------------------------
# Runtime logs
# ---------------------------------------------------------------------------
*.log
npm-debug.log
yarn-error.log

# ---------------------------------------------------------------------------
# Database DUMPS
#
# `.sql` is ignored globally because a throwaway dump is not source. The two
# exceptions ARE source:
#   - `db/postgres/migrations/` is the forward-only PostgreSQL baseline.
#   - `db/mysql/` holds the frozen legacy schema (MySQL still owns identity:
#     users, tokens and the role tables).
# ---------------------------------------------------------------------------
*.sql
!db/postgres/migrations/*.sql
!db/postgres/tests/*.sql
!db/mysql/*.sql

# ---------------------------------------------------------------------------
# Scratch scripts at the repository ROOT only.
#
# Unanchored patterns once matched at any depth and silently excluded real
# source files. The leading `/` keeps these to the place a one-off actually
# lives.
# ---------------------------------------------------------------------------
/check_*.mjs
/fix_*.mjs
/seed_*.mjs
/scratch_*.mjs
/inspect_*.mjs
/restore_*.mjs
/cleanup_*.mjs
/final_*.mjs
/verify_*.mjs
/debug_*.mjs
/tmp_*.mjs
/debug_*.json

# Scratch directories
/scratch/
/tmp/

# Local-only tooling and dev helpers
.mcp.json
.codex/
.claude/
.agents/
/.playwright-mcp/
/.mcp.json

# Nested tooling repos and local archives
/word-mcp-server/
/word-mcp-server.venv/
mobile.zip

# Local working documents: the committed record is the commit message, not a
# working file a reviewer has to read.
/REFINEMENT-PLAN.md
/REFINEMENT-*.md
/NOTES-*.md
/FINAL-SWEEP.md
/FINAL-SWEEP-*.md

# Scratch output regenerated on demand.
/.tmp/
/junit.xml
