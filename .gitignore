~$*
*.tmp

# ---------------------------------------------------------------------------
# Runtime logs
#
# `.log` is safe to match globally: no source file in this repository is a log.
# The sibling `*.txt` rule was REMOVED -- see the note below.
# ---------------------------------------------------------------------------
*.log
npm-debug.log
yarn-error.log

# ---------------------------------------------------------------------------
# Database DUMPS
#
# Scoped to a directory rather than matched by extension, because a `.sql` file
# under `scripts/` is CODE: `scripts/disbursement-migration-seed.sql` seeds the
# throwaway database that `verify-disbursement-migration.cmd` builds, and
# without it that proof cannot run on a fresh clone.
# ---------------------------------------------------------------------------
*.sql
!scripts/*.sql

# ---------------------------------------------------------------------------
# SCRATCH SCRIPTS -- ANCHORED TO THE REPOSITORY ROOT, DELIBERATELY
#
# These used to be unanchored (`debug_*.php` rather than `/debug_*.php`), which
# made them match at ANY depth. Verified consequences, none of which reported an
# error -- `git add` simply did not stage the file:
#
#     tests/Feature/test_login.php            would be ignored (test_*.php)
#     app/Services/verify_helper.php          would be ignored (verify_*.php)
#     database/seeders/seed_demo.php          would be ignored (seed_*.php)
#     app/Http/Middleware/debug_headers.php   would be ignored (debug_*.php)
#     tests/Unit/cleanup_helper.php           would be ignored (cleanup_*.php)
#
# That is the worst possible failure mode for a `.gitignore`: a file that a
# developer wrote, reviewed and committed to locally, permanently absent from
# the repository with no warning. It is also why this file had grown a block of
# `!` negations to force specific files back in.
#
# The leading `/` restricts each pattern to the repository root, which is where
# a one-off debug script actually lives. A legitimately named file anywhere else
# is now tracked normally.
# ---------------------------------------------------------------------------
/check_*.php
/fix_*.php
/seed_*.php
/scratch_*.php
/inspect_*.php
/restore_*.php
/cleanup_*.php
/final_*.php
/deep_*.php
/verify_*.php
/debug_*.php
/tmp_*.php
/debug_*.json
/hero-centered-check.png
/hero-centered-final.png
/houses-tab-fixed.png

# Scratch directories
/scratch/
/tmp/
/resources/js/scratch/
/mobile/

# NOTE: there is deliberately no `*.txt` rule. The previous file had one, and it
# was broad enough to silently exclude legitimate text files anywhere -- a
# `docs/notes.txt`, a `public/security.txt`. `public/robots.txt` survived only
# because it was committed before the rule was added. Text files are ordinary
# source; ignore them by path when you mean a specific one.

