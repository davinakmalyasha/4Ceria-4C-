{
  "name": "4ceria-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "npm run sync:styles && npm run sync:content && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "sync:styles": "node scripts/sync-styles.mjs",
    "sync:styles:check": "node scripts/sync-styles.mjs --check",
    "sync:content": "node scripts/sync-content.mjs",
    "sync:content:check": "node scripts/sync-content.mjs --check"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "0.577.0",
    "maplibre-gl": "^4.7.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
