# =============================================================================
# 4Ceria — environment
#
# Copy to `.env` and fill in. The API (Go gateway) reads these at process
# start; the Next.js app reads `API_ORIGIN` at request time.
# =============================================================================

# --- PostgreSQL: the application data (all tables, all auth) -----------------
# Local/portfolio default: everything runs from PostgreSQL. The gateway opens
# a pool and pins every session to UTC. Login, register, tokens and roles are
# PostgreSQL-native (Sanctum semantics preserved).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/4ceria_pgcheck

# --- MySQL: one-time seed only -------------------------------------------------
# Legacy source for `db/mysql/schema.sql` + `demo.sql`. Run `cmd/etl` once to
# seed PostgreSQL, then leave this empty — the gateway no longer needs it at
# runtime. Set only to re-seed or to run the historical parity check.
# MYSQL_DSN=root@tcp(127.0.0.1:3306)/4ceria?parseTime=false
MYSQL_DSN=

# --- The application ---------------------------------------------------------
# Used for absolute URLs, signed links and HMACs. Must be a 32-byte base64
# value, exactly as Laravel's `APP_KEY` was — the contract is unchanged.
APP_KEY=base64:AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=
APP_URL=http://127.0.0.1:8099

# --- Uploads -----------------------------------------------------------------
# Local directory for public uploads (avatars, house photos, requirement
# images). Contract, KYC, receipt and dispute files use the private store.
PUBLIC_STORAGE_ROOT=storage/app/public
EVIDENCE_DIR=storage/app/private

# --- Mail (password reset) ---------------------------------------------------
MAIL_FROM_ADDRESS=no-reply@4ceria.test
MAIL_FROM_NAME=4Ceria
RESEND_API_KEY=

# --- Web push ----------------------------------------------------------------
# VAPID keys for `SendWebPushJob` fan-out. Empty = in-app only (logged).
# Self-generate locally (P-256, base64url, no padding — no third party needed):
# node -e "const c=require('node:crypto'),b=x=>x.toString('base64').replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');const e=c.createECDH('prime256v1');e.generateKeys();console.log('PUB='+b(e.getPublicKey(null,'uncompressed'))+'\nPRIV='+b(e.getPrivateKey()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the VAPID `mailto:` subscriber claim.
VAPID_SUBJECT=mailto:no-reply@4ceria.test

# --- Object storage (S3-compatible) -------------------------------------------
# Empty = local disk (`PUBLIC_STORAGE_ROOT` / `EVIDENCE_DIR`) with HMAC-signed
# local URLs. Set all four to store new uploads in the bucket and presign
# GETs (15 min) instead of serving local bytes.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# --- AI assistant (Ceria chatbot, GO ADK v2 + DeepSeek) -------------------------
# Paste the key and the assistant answers; everything else has defaults.
# Without it the chat endpoints answer 503 and history keeps working.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# --- Geocoding ---------------------------------------------------------------
# Defaults to OpenStreetMap Nominatim when unset.
GEOCODING_ORIGIN=

# --- Next.js (web/.env.local) ------------------------------------------------
# The browser never calls the API directly; server components and route
# handlers use this origin.
API_ORIGIN=http://127.0.0.1:8099
