# =============================================================================
# 4Ceria — environment
#
# Copy to `.env` and fill in. The API (Go gateway) reads these at process
# start; the Next.js app reads `API_ORIGIN` at request time.
# =============================================================================

# --- PostgreSQL: the application data ---------------------------------------
# Every table except identity lives here. The gateway opens a pool and pins
# every session to UTC.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/4ceria_pgcheck

# --- MySQL: identity only (ADR-0018) ----------------------------------------
# `users`, `personal_access_tokens` and the Spark/role tables stay MySQL-owned
# during the transition. The Go service reads and writes them directly, then
# re-syncs the touched rows into PostgreSQL. Leave empty to run the gateway
# without identity (route-parity and tests do that).
MYSQL_DSN=root@tcp(127.0.0.1:3306)/4ceria?parseTime=false

# --- The application ---------------------------------------------------------
# Used for absolute URLs, signed links and HMACs. Must be a 32-byte base64
# value, exactly as Laravel's `APP_KEY` was — the contract is unchanged.
APP_KEY=base64:AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=
APP_URL=http://127.0.0.1:8099

# --- Uploads -----------------------------------------------------------------
# Local directory for public uploads (avatars, house photos, requirement
# images). Contract, KYC, receipt and dispute files use the private store.
PUBLIC_STORAGE_ROOT=storage/app/public
EVIDENCE_DIR=storage/app/private

# --- Mail (password reset) ---------------------------------------------------
MAIL_FROM_ADDRESS=no-reply@4ceria.test
MAIL_FROM_NAME=4Ceria
RESEND_API_KEY=

# --- Web push ----------------------------------------------------------------
VAPID_PUBLIC_KEY=

# --- Geocoding ---------------------------------------------------------------
# Defaults to OpenStreetMap Nominatim when unset.
GEOCODING_ORIGIN=

# --- Next.js (web/.env.local) ------------------------------------------------
# The browser never calls the API directly; server components and route
# handlers use this origin.
API_ORIGIN=http://127.0.0.1:8099
