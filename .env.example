APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# REQUIRED IN PRODUCTION. Comma-separated CIDR list of the reverse proxy / platform
# edge that terminates TLS in front of this app (Railway, Cloudflare, an nginx
# sidecar, ...). bootstrap/app.php refuses to boot in production without it.
#
# Why it is mandatory rather than cosmetic: `request->ip()` derives from
# X-Forwarded-For only for TRUSTED proxies, and that value is what rate limiting
# and audit logs key on. Two bad settings, both of which this variable avoids:
#
#   trust nothing -> every request appears to come from the edge IP, so all users
#                    share one bucket and `throttle:10,1` on /login becomes a
#                    denial-of-service against your own users;
#   trust "*"     -> any client sets X-Forwarded-For and gets a fresh bucket per
#                    request, so credential stuffing and mass registration are
#                    effectively unthrottled.
#
# Local development and the test suite do not need this and fall back to "*".
# Example: TRUSTED_PROXIES=10.0.0.0/8,172.64.0.0/13
TRUSTED_PROXIES=

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# `stderr` is REQUIRED in production/containers. Supervisord only drains stdout,
# and `storage/logs/*.log` lives on the container's ephemeral filesystem, so a
# daily/single-only stack means EVERY Laravel log line (and every 500) is thrown
# away on deploy. With `stderr` in the stack, Railway/Vercel collect them.
# For local development keep `single` for a browsable file.
LOG_STACK=stderr,single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=your-railway-redis-host
REDIS_PASSWORD=your-railway-redis-password
REDIS_PORT=your-railway-redis-port

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@4ceria.com
MAIL_FROM_NAME="4C Platform"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Driver for the "public" disk (local = public/storage symlink, s3 = S3-compatible)
PUBLIC_STORAGE_DRIVER=local

# Disk for the project document vault (contracts, legally-binding files).
# railway (default, private bucket) in production; public is fine locally.
VAULT_DISK=railway

# ---------------------------------------------------------------------------
# Escrow: retention, warranty and platform fee
#
# All four default to the values the product copy promises, so a fresh clone
# behaves like production without configuring anything.
# ---------------------------------------------------------------------------

# Indonesian retention (potong): the slice of each payment stage withheld until the
# warranty expires. The completion payment debits only the NET; the withheld part is
# released by `php artisan escrow:release-retention` once the warranty has lapsed and
# no claim is contesting it.
ESCROW_RETENTION_PERCENT=5

# Warranty window, used to decide when retention becomes releasable. Read from the
# project's recorded warranty_end_at, so changing this later does not move money on a
# date the client was already shown.
ESCROW_WARRANTY_DAYS=180

# Retained for projects whose warranty is expressed in months rather than days.
ESCROW_WARRANTY_MONTHS=

# Claim states that BLOCK a retention release. `resolved` and `closed` deliberately
# do not block: the work was done and its cost settled, so holding the money would
# strand a balance nobody is contesting.
ESCROW_BLOCKING_CLAIM_STATES=open,fixing

# Platform fee, charged as its own ledger row BESIDE the payment it applies to, so it
# is never taken out of the professional's fee and can be reconciled against the
# payment it belongs to.
#
# 0 by default. The shipped product copy tells clients there is no fee and that one
# "will be itemised on the project ledger", so leaving this at 0 keeps that literally
# true. Set it only once you intend to charge.
ESCROW_PLATFORM_FEE_PERCENT=0

# Deployed SPA origin — locks down CORS. Leave empty for local dev.
FRONTEND_URL=

# Vercel project slug for preview-deployment CORS (e.g. "4ceria-web" allows
# 4ceria-web.vercel.app and 4ceria-web-git-*.vercel.app). Anything else on
# *.vercel.app is rejected.
VERCEL_PROJECT_SLUG=4ceria-web

# Comma-separated list of trusted proxy CIDRs/IPs (e.g. Railway's egress
# ranges). "*" trusts every proxy header — spoofable X-Forwarded-For breaks
# rate limiting; pin this in production.
TRUSTED_PROXIES=

# Laravel Octane server (frankenphp|roadrunner|swoole), leave empty to use artisan serve
OCTANE_SERVER=

# Railway Object Storage (Tigris, S3-compatible) — private "railway" disk for
# contracts / KYC / requirement images. Rename these same variables in your
# Railway dashboard when deploying.
RAILWAY_STORAGE_ACCESS_KEY_ID=
RAILWAY_STORAGE_SECRET_ACCESS_KEY=
RAILWAY_STORAGE_REGION=auto
RAILWAY_STORAGE_BUCKET=verifications4C
RAILWAY_STORAGE_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"
# Base URL for axios in standalone SPA builds (Vercel); empty = same-origin
VITE_API_URL=
# Set to true to build a standalone SPA into dist/ without the Laravel plugin
VITE_STANDALONE=false

# Web Push (VAPID) — generate with:
#   php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());"
# (On Windows, set OPENSSL_CONF to PHP's extras/ssl/openssl.cnf first if keygen fails.)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@4ceria.com"
