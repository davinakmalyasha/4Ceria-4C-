APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=your-railway-redis-host
REDIS_PASSWORD=your-railway-redis-password
REDIS_PORT=your-railway-redis-port

MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@4ceria.com
MAIL_FROM_NAME="4C Platform"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Driver for the "public" disk (local = public/storage symlink, s3 = S3-compatible)
PUBLIC_STORAGE_DRIVER=local

# Disk for the project document vault (contracts, legally-binding files).
# railway (default, private bucket) in production; public is fine locally.
VAULT_DISK=railway

# Deployed SPA origin — locks down CORS. Leave empty for local dev.
FRONTEND_URL=

# Vercel project slug for preview-deployment CORS (e.g. "4ceria-web" allows
# 4ceria-web.vercel.app and 4ceria-web-git-*.vercel.app). Anything else on
# *.vercel.app is rejected.
VERCEL_PROJECT_SLUG=4ceria-web

# Comma-separated list of trusted proxy CIDRs/IPs (e.g. Railway's egress
# ranges). "*" trusts every proxy header — spoofable X-Forwarded-For breaks
# rate limiting; pin this in production.
TRUSTED_PROXIES=

# Laravel Octane server (frankenphp|roadrunner|swoole), leave empty to use artisan serve
OCTANE_SERVER=

# Railway Object Storage (Tigris, S3-compatible) — private "railway" disk for
# contracts / KYC / requirement images. Rename these same variables in your
# Railway dashboard when deploying.
RAILWAY_STORAGE_ACCESS_KEY_ID=
RAILWAY_STORAGE_SECRET_ACCESS_KEY=
RAILWAY_STORAGE_REGION=auto
RAILWAY_STORAGE_BUCKET=verifications4C
RAILWAY_STORAGE_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"
# Base URL for axios in standalone SPA builds (Vercel); empty = same-origin
VITE_API_URL=
# Set to true to build a standalone SPA into dist/ without the Laravel plugin
VITE_STANDALONE=false
