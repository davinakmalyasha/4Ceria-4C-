# =============================================================================
# 4Ceria — environment
#
# Copy to `.env` for the Go gateway, and set API_ORIGIN in `web/.env.local`
# (or the shell) for Next.js. The gateway reads this file at process start;
# Next reads its origin at request time.
# =============================================================================

# --- PostgreSQL: every table, including identity and auth -------------------
# Local default. The database must be created with LC_COLLATE=C LC_CTYPE=C.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/4ceria_pgcheck

# --- Application -------------------------------------------------------------
# Used to sign local storage URLs and contract signatures. Keep it secret and
# stable: changing it invalidates every signed link.
APP_KEY=base64:AQIDBAUGBwgJCgsMDQ4PEBESExQVFhcYGRobHB0eHyA=
APP_URL=http://127.0.0.1:8099
# Public web origin used in password-reset emails.
FRONTEND_URL=http://127.0.0.1:3000
# Optional CDN/web origin for absolute public asset URLs. Empty = APP_URL.
PUBLIC_ASSET_BASE=

# Comma-separated CIDRs/IPs whose X-Forwarded-For and X-Forwarded-Proto headers
# are trusted. Leave empty when the gateway is directly exposed.
TRUSTED_PROXIES=

# Optional shared secret for GET /internal/routes. When unset, that endpoint is
# loopback-only.
INTERNAL_ROUTES_TOKEN=

# --- Uploads -----------------------------------------------------------------
# Public files (avatars, house photos, materials) and private files (receipts,
# evidence, contracts). Both directories are created on demand.
PUBLIC_STORAGE_ROOT=storage/app/public
EVIDENCE_DIR=storage/app/private

# --- Mail --------------------------------------------------------------------
MAIL_FROM_ADDRESS=no-reply@4ceria.test
MAIL_FROM_NAME=4Ceria
# Unset = log driver (nothing leaves the machine).
RESEND_API_KEY=

# --- Web push ----------------------------------------------------------------
# P-256 VAPID keys, base64url without padding. Empty disables push fan-out
# while keeping in-app notifications. Generate a pair with:
# node -e "const c=require('node:crypto'),b=x=>x.toString('base64').replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');const e=c.createECDH('prime256v1');e.generateKeys();console.log('PUB='+b(e.getPublicKey(null,'uncompressed'))+'\nPRIV='+b(e.getPrivateKey()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@4ceria.test

# --- Object storage (S3-compatible) -----------------------------------------
# Leave empty to use local disk with HMAC-signed URLs. Set all four to store
# uploads in a bucket and presign GETs for 15 minutes.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# --- AI assistant ------------------------------------------------------------
# Without a key the chat endpoints answer 503 and history still works.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# --- Geocoding ---------------------------------------------------------------
# Defaults to OpenStreetMap Nominatim when unset.
GEOCODING_ORIGIN=

# --- Next.js (web/.env.local) ------------------------------------------------
# Server-side origin of the API. The browser never calls it directly.
API_ORIGIN=http://127.0.0.1:8099
# Public origin used for canonical/OpenGraph metadata.
SITE_URL=http://127.0.0.1:3000
# Local production-mode testing over HTTP needs this set to false.
# SESSION_COOKIE_SECURE=true
