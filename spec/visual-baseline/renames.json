{
  "_comment": [
    "The class renames the Tailwind v4 upgrade codemod applied.",
    "",
    "The v3 stylesheet was built from the PRE-codemod source, so it carries the",
    "OLD class names. The v4 stylesheet carries the new ones. Comparing them",
    "without this map compares `shadow-sm` (v3: 0.05) with `shadow-sm`",
    "(v4: 0.1) — which are not the same class.",
    "",
    "Every entry is a v3 name -> a v4 name, and every one renders the SAME",
    "picture in its new form. The map is what turns 'the class name changed'",
    "into 'the class was renamed and the picture did not'.",
    "",
    "The evidence is `scripts/visual/computed-styles.mjs`: it renders every",
    "class the stylesheet defines in a real browser and records the computed",
    "style, and `compare-computed.mjs` diffs the two builds with these",
    "renames applied."
  ],

  "bg-gradient-to-b": "bg-linear-to-b",
  "bg-gradient-to-br": "bg-linear-to-br",
  "bg-gradient-to-r": "bg-linear-to-r",
  "bg-gradient-to-t": "bg-linear-to-t",
  "bg-gradient-to-tr": "bg-linear-to-tr",

  "rounded-[1.5rem]": "rounded-3xl",
  "rounded-[1rem]": "rounded-2xl",
  "rounded-[2rem]": "rounded-4xl",
  "rounded-l-[1.5rem]": "rounded-l-3xl",
  "rounded-t-[1.5rem]": "rounded-t-3xl",
  "lg:rounded-[1.5rem]": "lg:rounded-3xl",

  "z-[45]": "z-45",
  "z-[60]": "z-60",
  "z-[70]": "z-70",
  "z-[80]": "z-80",
  "z-[90]": "z-90",
  "z-[100]": "z-100",
  "z-[110]": "z-110",
  "z-[115]": "z-115",
  "z-[120]": "z-120",
  "z-[130]": "z-130",
  "z-[150]": "z-150",
  "z-[200]": "z-200",
  "z-[201]": "z-201",
  "z-[300]": "z-300",
  "z-[1000]": "z-1000",
  "z-[9999]": "z-9999",
  "z-[99999]": "z-99999",
  "z-[100000]": "z-100000",
  "z-[999999]": "z-999999",

  "break-words": "wrap-break-word",
  "flex-[2]": "flex-2",
  "flex-shrink": "shrink",
  "flex-shrink-0": "shrink-0",
  "flex-grow": "grow",
  "blur-[40px]": "blur-2xl",
  "stroke-[3]": "stroke-3",
  "mt-[1px]": "mt-px",
  "w-[1px]": "w-px",
  "before:w-[1px]": "before:w-px",
  "left-[1.125rem]": "left-4.5",
  "-left-[13px]": "left-[-13px]",
  "-ml-[18px]": "ml-[-18px]",

  "tracking-[0.05em]": "tracking-wider",
  "tracking-[0.1em]": "tracking-widest",

  "bg-white/[0.02]": "bg-white/2",
  "hover:bg-white/[0.04]": "hover:bg-white/4",
  "hover:bg-white/[0.08]": "hover:bg-white/8",
  "hover:shadow-red-500/[0.02]": "hover:shadow-red-500/2",

  "aspect-[4/3]": "aspect-4/3",
  "aspect-[21/9]": "aspect-21/9",

  "bg-[size:20px_20px]": "bg-size-[20px_20px]",
  "bg-[size:24px_24px]": "bg-size-[24px_24px]",
  "[background-size:16px_16px]": "bg-size-[16px_16px]",

  "outline-none": "outline-hidden",
  "ring": "ring-3"
}
